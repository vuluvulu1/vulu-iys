@page "/personel"
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<h1>Personel</h1>

@if (!Oturum.AdminMi)
{
    <p class="hata">Bu sayfayı yalnızca yöneticiler görebilir.</p>
}
else
{
    <div class="arac-cubugu">
        <button @onclick="YeniAc">Yeni personel</button>
        <button class="ikincil" @onclick="Yukle" disabled="@_yukleniyor">Yenile</button>
    </div>

    @if (_listeHatasi is not null)
    {
        <p class="hata" role="alert">@_listeHatasi</p>
    }

    @if (_personel is null)
    {
        <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
    }
    else
    {
        <table class="tablo">
            <thead>
                <tr>
                    <th>Ad soyad</th>
                    <th>Kullanıcı adı</th>
                    <th>Telefon</th>
                    <th>Uzmanlık</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kisi in _personel)
                {
                    <tr @key="kisi.Id">
                        <td>
                            @kisi.AdSoyad
                            @if (kisi.Id == Oturum.Kullanici?.Id)
                            {
                                <span class="rozet">siz</span>
                            }
                        </td>
                        <td>@kisi.KullaniciAdi</td>
                        <td>@(kisi.Telefon ?? "—")</td>
                        <td>@(kisi.Uzmanlik ?? "—")</td>
                        <td>@RolAdi(kisi.Rol)</td>
                        <td>
                            <span class="@(kisi.AktifMi ? "durum iyi" : "durum kotu")">
                                @(kisi.AktifMi ? "Aktif" : "Devre dışı")
                            </span>
                        </td>
                        <td class="islemler">
                            <button class="ikincil" @onclick="() => DuzenleAc(kisi)">Düzenle</button>
                            <button class="tehlike" @onclick="() => _silinecek = kisi"
                                    disabled="@(kisi.Id == Oturum.Kullanici?.Id)">Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (_form is not null)
{
    <Pencere Baslik="@(_duzenlenen is null ? "Yeni personel" : "Personeli düzenle")" Genis="true" KapatIstendi="FormuKapat">
        <form @onsubmit="Kaydet">
            <label for="f-adsoyad">Ad soyad</label>
            <input id="f-adsoyad" @bind="_form.AdSoyad" @bind:event="oninput" autocomplete="off" />

            <div class="iki-sutun">
                <div>
                    <label for="f-telefon">Telefon (isteğe bağlı)</label>
                    <input id="f-telefon" @bind="_form.Telefon" @bind:event="oninput" inputmode="numeric" maxlength="11"
                           placeholder="05551234567" autocomplete="off" />
                </div>
                <div>
                    <label for="f-uzmanlik">Uzmanlık (isteğe bağlı)</label>
                    <input id="f-uzmanlik" @bind="_form.Uzmanlik" @bind:event="oninput" autocomplete="off" />
                </div>
            </div>

            <h3 class="form-basligi">Giriş bilgileri</h3>

            <div class="iki-sutun">
                <div>
                    <label for="f-ad">Kullanıcı adı</label>
                    <input id="f-ad" @bind="_form.KullaniciAdi" @bind:event="oninput" autocomplete="off" />
                </div>
                <div>
                    <label for="f-sifre">@(_duzenlenen is null ? "Şifre" : "Yeni şifre (boşsa değişmez)")</label>
                    <input id="f-sifre" type="password" @bind="_form.Sifre" @bind:event="oninput" autocomplete="new-password" />
                </div>
            </div>

            <label for="f-rol">Rol</label>
            <select id="f-rol" @bind="_form.Rol">
                <option value="@KullaniciRol.Teknisyen">Teknisyen</option>
                <option value="@KullaniciRol.Admin">Yönetici</option>
            </select>

            @if (_duzenlenen is not null)
            {
                <label class="onay-kutusu">
                    <input id="f-aktif" type="checkbox" @bind="_form.AktifMi" />
                    Hesap aktif (devre dışı bırakılan personel giriş yapamaz ve yeni iş atanamaz)
                </label>
            }

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="FormuKapat" />
        </form>
    </Pencere>
}

@if (_silinecek is not null)
{
    <SilmeOnayi Baslik="Personeli sil" Hata="@_silmeHatasi" Mesgul="_kaydediliyor" Onayla="Sil" Vazgec="SilmeyiKapat">
        <strong>@_silinecek.AdSoyad</strong> (@_silinecek.KullaniciAdi) kalıcı olarak silinecek. Bu işlem geri alınamaz.
        Üzerinde iş geçmişi olan personel silinemez; onun yerine hesabı devre dışı bırakın.
    </SilmeOnayi>
}

@code {
    private class PersonelFormu
    {
        public string AdSoyad { get; set; } = "";
        public string Telefon { get; set; } = "";
        public string Uzmanlik { get; set; } = "";
        public string KullaniciAdi { get; set; } = "";
        public string Sifre { get; set; } = "";
        public KullaniciRol Rol { get; set; } = KullaniciRol.Teknisyen;
        public bool AktifMi { get; set; } = true;
    }

    private List<KullaniciOzeti>? _personel;
    private string? _listeHatasi;
    private bool _yukleniyor;

    private PersonelFormu? _form;
    private KullaniciOzeti? _duzenlenen;
    private string? _formHatasi;
    private bool _kaydediliyor;

    private KullaniciOzeti? _silinecek;
    private string? _silmeHatasi;

    protected override Task OnInitializedAsync() => Oturum.AdminMi ? Yukle() : Task.CompletedTask;

    private static string RolAdi(KullaniciRol rol) => rol == KullaniciRol.Admin ? "Yönetici" : "Teknisyen";

    private static string? BosIseNull(string deger) => string.IsNullOrWhiteSpace(deger) ? null : deger.Trim();

    private async Task Yukle()
    {
        _yukleniyor = true;
        var sonuc = await Api.Getir<List<KullaniciOzeti>>("api/kullanicilar");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (sonuc.Basarili)
            _personel = sonuc.Deger ?? [];
    }

    private void YeniAc()
    {
        _duzenlenen = null;
        _formHatasi = null;
        _form = new PersonelFormu();
    }

    private void DuzenleAc(KullaniciOzeti kisi)
    {
        _duzenlenen = kisi;
        _formHatasi = null;
        _form = new PersonelFormu
        {
            AdSoyad = kisi.AdSoyad,
            Telefon = kisi.Telefon ?? "",
            Uzmanlik = kisi.Uzmanlik ?? "",
            KullaniciAdi = kisi.KullaniciAdi,
            Rol = kisi.Rol,
            AktifMi = kisi.AktifMi
        };
    }

    private void FormuKapat() => _form = null;

    private async Task Kaydet()
    {
        if (_form is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = _duzenlenen is null
            ? await Api.Ekle<KullaniciOzeti>("api/kullanicilar",
                new KullaniciOlusturIstegi(_form.KullaniciAdi.Trim(), _form.Sifre, _form.Rol, _form.AdSoyad.Trim(),
                    BosIseNull(_form.Telefon), BosIseNull(_form.Uzmanlik)))
            : await Api.Guncelle<KullaniciOzeti>($"api/kullanicilar/{_duzenlenen.Id}",
                new KullaniciGuncelleIstegi(_form.KullaniciAdi.Trim(), _form.Rol, _form.AktifMi,
                    _form.Sifre.Length > 0 ? _form.Sifre : null, _form.AdSoyad.Trim(),
                    BosIseNull(_form.Telefon), BosIseNull(_form.Uzmanlik)));
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _form = null;
        await Yukle();
    }

    private void SilmeyiKapat()
    {
        _silinecek = null;
        _silmeHatasi = null;
    }

    private async Task Sil()
    {
        if (_silinecek is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = await Api.Sil($"api/kullanicilar/{_silinecek.Id}");
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _silmeHatasi = sonuc.Hata;
            return;
        }

        SilmeyiKapat();
        await Yukle();
    }
}
