@inject OturumServisi Oturum
@inject HttpClient Http

<div class="giris-kabugu">
    <form class="giris-karti" @onsubmit="GirisYap">
        <img class="giris-logo" src="img/logo.svg" alt="vulu" />
        <h1>İşletme Yönetim Sistemi</h1>

        @switch (_sunucu)
        {
            case SunucuDurumu.Kontrol:
                <p class="soluk bilgi">Sunucuya bağlanılıyor… Sunucu uykudaysa bu bir dakika kadar sürebilir.</p>
                break;

            case SunucuDurumu.Ulasilamiyor:
                <p class="hata bilgi" role="alert">Sunucuya ulaşılamadı. İnternet bağlantınızı kontrol edin.</p>
                <button type="button" @onclick="SunucuyuKontrolEt">Yeniden dene</button>
                break;

            case SunucuDurumu.GuncellemeGerekli:
                <p class="bilgi" role="status">
                    Yeni sürüm yayımlandı: <strong>@_yeniSurum!.Surum</strong> (kurulu olan @Guncelleyici.MevcutSurum).
                    Devam etmek için uygulamanın güncellenmesi gerekiyor.
                </p>
                @if (_indirmeYuzdesi is { } yuzde)
                {
                    <progress max="100" value="@yuzde" aria-label="İndirme ilerlemesi"></progress>
                    <p class="soluk bilgi">İndiriliyor… %@yuzde</p>
                }
                else
                {
                    @if (_hata is not null)
                    {
                        <p class="hata" role="alert">@_hata</p>
                    }
                    <button type="button" @onclick="Guncelle">@(_hata is null ? "Güncelle" : "Yeniden dene")</button>
                    <p class="soluk bilgi">Güncelleme indirilir, kurulur ve uygulama kendiliğinden yeniden açılır.</p>
                }
                break;

            case SunucuDurumu.SurumUyumsuz:
                <p class="hata bilgi" role="alert">
                    Bu uygulama sürümü sunucuyla uyumlu değil. Lütfen uygulamanın güncel sürümünü kurun.
                </p>
                break;

            case SunucuDurumu.Hazir:
                <label for="isletme-kodu">İşletme kodu</label>
                <input id="isletme-kodu" @bind="_isletmeKodu" @bind:event="oninput" autocomplete="organization"
                       autocapitalize="none" spellcheck="false" />

                <label for="kullanici-adi">Kullanıcı adı</label>
                <input id="kullanici-adi" @bind="_kullaniciAdi" @bind:event="oninput" autocomplete="username" />

                <label for="sifre">Şifre</label>
                <input id="sifre" type="password" @bind="_sifre" @bind:event="oninput" autocomplete="current-password" />

                @if (_hata is not null)
                {
                    <p class="hata" role="alert">@_hata</p>
                }

                <button type="submit" disabled="@(_bekliyor || !Dolu)">
                    @(_bekliyor ? "Giriş yapılıyor…" : "Giriş yap")
                </button>
                break;
        }
    </form>
</div>

@code {
    private enum SunucuDurumu { Kontrol, Hazir, Ulasilamiyor, SurumUyumsuz, GuncellemeGerekli }

    private SunucuDurumu _sunucu = SunucuDurumu.Kontrol;
    private string _isletmeKodu = "";
    private string _kullaniciAdi = "";
    private string _sifre = "";
    private string? _hata;
    private bool _bekliyor;
    private YeniSurum? _yeniSurum;
    private int? _indirmeYuzdesi;

    private bool Dolu => !string.IsNullOrWhiteSpace(_isletmeKodu) && !string.IsNullOrWhiteSpace(_kullaniciAdi) && _sifre.Length > 0;

    protected override Task OnInitializedAsync()
    {
        _isletmeKodu = YerelAyarlar.SonIsletmeKodu;
        return SunucuyuKontrolEt();
    }

    // Giriş formu, uygulamanın güncel olduğu, sunucuya ulaşıldığı ve sürümün uyumlu olduğu görülmeden açılmaz.
    private async Task SunucuyuKontrolEt()
    {
        _sunucu = SunucuDurumu.Kontrol;

        // Güncelleme zorunludur: yeni sürüm varsa giriş formu hiç gösterilmez. Sürüm bilgisine ulaşılamazsa
        // (internet yok, GitHub yanıt vermiyor) kontrol atlanır; uygulama bu yüzden kullanılamaz kalmaz.
        _yeniSurum = await Guncelleyici.KontrolEt();
        if (_yeniSurum is not null)
        {
            _sunucu = SunucuDurumu.GuncellemeGerekli;
            return;
        }

        try
        {
            // Veritabanı kapalıyken dönen 503 de sürüm bilgisini taşır; durum koduna bakılmaz.
            using var yanit = await Http.GetAsync("api/saglik");
            var saglik = await yanit.Content.ReadFromJsonAsync<SaglikYaniti>();
            _sunucu = saglik?.SozlesmeSurumu == ApiSozlesmesi.Surum ? SunucuDurumu.Hazir : SunucuDurumu.SurumUyumsuz;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _sunucu = SunucuDurumu.Ulasilamiyor;
        }
    }

    private async Task Guncelle()
    {
        if (_yeniSurum is null || _indirmeYuzdesi is not null) return;

        _hata = null;
        _indirmeYuzdesi = 0;
        // Başarılıysa uygulama kapanır ve bu satırdan sonrası çalışmaz.
        _hata = await Guncelleyici.IndirVeKur(_yeniSurum, yuzde =>
        {
            _indirmeYuzdesi = yuzde;
            InvokeAsync(StateHasChanged);
        });
        _indirmeYuzdesi = null;
    }

    private async Task GirisYap()
    {
        if (_sunucu != SunucuDurumu.Hazir || _bekliyor || !Dolu) return;

        _bekliyor = true;
        _hata = null;
        _hata = await Oturum.GirisYap(_isletmeKodu, _kullaniciAdi, _sifre);
        _sifre = "";
        _bekliyor = false;

        if (_hata is null)
            YerelAyarlar.SonIsletmeKodu = _isletmeKodu.Trim().ToLowerInvariant();
    }
}
