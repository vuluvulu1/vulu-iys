@* Vulu yöneticisinin ekranı: işletmeler ve vulu yöneticisi hesapları. *@
@inject OturumServisi Oturum

<div class="kabuk">
    <aside class="yan-menu">
        <div class="marka">
            <img src="img/logo.svg" alt="" />
            <span>vulu</span>
        </div>

        <nav>
            <a href="" class="@(_yoneticiler ? "" : "active")" @onclick="() => _yoneticiler = false" @onclick:preventDefault>İşletmeler</a>
            <a href="" class="@(_yoneticiler ? "active" : "")" @onclick="() => _yoneticiler = true" @onclick:preventDefault>Vulu Yöneticileri</a>
        </nav>

        <div class="oturum">
            <div class="oturum-adi">@Oturum.Kullanici?.AdSoyad</div>
            <div class="oturum-rol">Vulu yöneticisi</div>
            <button class="ikincil" @onclick="Oturum.CikisYap">Çıkış yap</button>
        </div>
    </aside>

    <main class="icerik">
        @if (_yoneticiler)
        {
            <VuluYoneticiler />
        }
        else
        {
            <VuluIsletmeler />
        }
    </main>
</div>

@code {
    private bool _yoneticiler;
}
