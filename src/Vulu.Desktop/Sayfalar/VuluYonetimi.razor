@* Vulu yöneticisinin ekranı: işletmeler, vulu yöneticisi hesapları ve sunucu denetimi. *@

<div class="kabuk">
    <aside class="yan-menu">
        <div class="marka">
            <img src="img/logo.svg" alt="" />
            <span>vulu</span>
        </div>

        <nav>
            @foreach (var bolum in Enum.GetValues<Bolum>())
            {
                <a href="" class="@(bolum == _bolum ? "active" : "")" @onclick="() => _bolum = bolum" @onclick:preventDefault>
                    @BolumAdi(bolum)
                </a>
            }
        </nav>

        <OturumKutusu Rol="Vulu yöneticisi" />
    </aside>

    <main class="icerik">
        @switch (_bolum)
        {
            case Bolum.Isletmeler:
                <VuluIsletmeler />
                break;
            case Bolum.Yoneticiler:
                <VuluYoneticiler />
                break;
            default:
                <VuluSunucu />
                break;
        }
    </main>
</div>

@code {
    private enum Bolum { Isletmeler, Yoneticiler, Sunucu }

    private Bolum _bolum = Bolum.Isletmeler;

    private static string BolumAdi(Bolum bolum) => bolum switch
    {
        Bolum.Isletmeler => "İşletmeler",
        Bolum.Yoneticiler => "Vulu Yöneticileri",
        _ => "Sunucu"
    };
}
