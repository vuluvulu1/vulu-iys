@page "/kisisel-veriler"
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<h1>Kişisel Veriler</h1>

@if (!Oturum.AdminMi)
{
    <p class="hata">Bu sayfayı yalnızca yöneticiler görebilir.</p>
}
else
{
    <p class="soluk aciklama">
        Müşterilerin KVKK kapsamındaki başvuruları buradan karşılanır: hakkında tutulan verinin dökümü ve kişisel
        verinin kalıcı olarak silinmesi. Saklama süresi ve kabul formundaki aydınlatma metni
        <a href="isletme">İşletme</a> sayfasından ayarlanır.
    </p>

    @if (_hata is not null)
    {
        <p class="hata" role="alert">@_hata</p>
    }

    <section class="kart genis">
        <h2>Müşteri başvurusu</h2>
        <MusteriSecici Secili="_secili" SeciliChanged="musteri => _secili = musteri" />
        @if (_secili is not null)
        {
            <div class="bolum-dugmesi">
                <ExcelDugmesi Yol="@DokumYolu(_secili.Id)" DosyaAdi="Musteri-verisi" Metin="Veri dökümünü indir" />
                <button type="button" class="tehlike" @onclick="() => SilmeyiAc(_secili.Id, _secili.AdSoyad)">Kişisel verileri kalıcı olarak sil</button>
            </div>
        }
    </section>

    @if (_durum is null)
    {
        <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
    }
    else
    {
        <section class="kart genis">
            <h2>Listeden kaldırılmış müşteriler</h2>
            <p class="soluk aciklama">
                Müşteriler sayfasından silinen müşteriler listede görünmez, ama geçmiş kayıtları bozulmasın diye verileri
                saklanır. Kalıcı olarak silinene kadar burada dururlar.
            </p>
            @MusteriTablosu(_durum.Silinmisler, "Listeden kaldırılmış müşteri yok.")
        </section>

        <section class="kart genis">
            <h2>Saklama süresi dolanlar</h2>
            <p class="soluk aciklama">
                Son işlemi @_durum.SaklamaYili yıldan eski olan müşteriler. Bu verileri tutmak için bir neden kalmadıysa silinmeleri gerekir.
            </p>
            @MusteriTablosu(_durum.SuresiDolanlar, "Saklama süresi dolan müşteri yok.")
        </section>
    }
}

@if (_silinecek is { } silinecek)
{
    <SilmeOnayi Baslik="Kişisel verileri kalıcı olarak sil" Hata="@_silmeHatasi" Mesgul="_siliniyor" Onayla="Sil" Vazgec="SilmeyiKapat">
        <strong>@silinecek.Ad</strong> adlı müşterinin adı, telefonu, e-postası, adresi, randevuları ve cihazlarının seri
        numaraları silinecek. Servis kayıtları “Silinen müşteri” adıyla kalır. Bu işlem geri alınamaz.
    </SilmeOnayi>
}

@code {
    private KvkkDurumu? _durum;
    private MusteriYaniti? _secili;
    private string? _hata;
    private bool _yukleniyor;

    private (string Id, string Ad)? _silinecek;
    private string? _silmeHatasi;
    private bool _siliniyor;

    private static string DokumYolu(string musteriId) => $"api/kisisel-veriler/musteriler/{musteriId}/dokum";

    protected override Task OnInitializedAsync() => Oturum.AdminMi ? Yukle() : Task.CompletedTask;

    private async Task Yukle()
    {
        _yukleniyor = true;
        var sonuc = await Api.Getir<KvkkDurumu>("api/kisisel-veriler");
        _yukleniyor = false;

        _hata = sonuc.Hata;
        if (sonuc.Basarili) _durum = sonuc.Deger;
    }

    private RenderFragment MusteriTablosu(IReadOnlyList<KvkkMusterisi> musteriler, string bosMetin) => @<text>
        @if (musteriler.Count == 0)
        {
            <p class="soluk">@bosMetin</p>
        }
        else
        {
            <table class="tablo sik">
                <thead>
                    <tr><th>Müşteri</th><th>Telefon</th><th>Son işlem</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var musteri in musteriler)
                    {
                        <tr @key="musteri.Id">
                            <td>@musteri.AdSoyad</td>
                            <td>@(musteri.Telefon ?? "—")</td>
                            <td class="dar">@Bicim.Tarih(musteri.SonIslemTarihi)</td>
                            <td class="islemler">
                                <ExcelDugmesi Yol="@DokumYolu(musteri.Id)" DosyaAdi="Musteri-verisi" Metin="Döküm" />
                                <button type="button" class="tehlike" @onclick="() => SilmeyiAc(musteri.Id, musteri.AdSoyad)">Kalıcı sil</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </text>;

    private void SilmeyiAc(string id, string ad)
    {
        _silinecek = (id, ad);
        _silmeHatasi = null;
    }

    private void SilmeyiKapat() => _silinecek = null;

    private async Task Sil()
    {
        if (_silinecek is not { } silinecek) return;

        _siliniyor = true;
        var sonuc = await Api.Sil($"api/kisisel-veriler/musteriler/{silinecek.Id}");
        _siliniyor = false;

        if (!sonuc.Basarili)
        {
            // Sunucu, silinemiyorsa nedenini (açık iş, saklama süresi dolmamış fatura) açıklar.
            _silmeHatasi = sonuc.Hata;
            return;
        }

        _silinecek = null;
        if (_secili?.Id == silinecek.Id) _secili = null;
        await Yukle();
    }
}
