@page "/randevular"
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<h1>Randevular</h1>

<div class="arac-cubugu">
    <button @onclick="() => YeniAc(null)">Yeni randevu</button>

    <div class="gorunum-secimi" role="group" aria-label="Görünüm">
        <button class="@(_takvim ? "ikincil" : "")" aria-pressed="@(_takvim ? "false" : "true")" @onclick="() => GorunumSec(false)">Liste</button>
        <button class="@(_takvim ? "" : "ikincil")" aria-pressed="@(_takvim ? "true" : "false")" @onclick="() => GorunumSec(true)">Takvim</button>
    </div>

    <select class="suzgec" aria-label="Duruma göre süz" @bind="_durum" @bind:after="SuzgecDegisti">
        <option value="">Tüm durumlar</option>
        @foreach (var durum in Enum.GetValues<RandevuDurumu>())
        {
            <option value="@durum">@Bicim.Durum(durum)</option>
        }
    </select>

    <AramaKutusu YerTutucu="Müşteri adı veya telefonu ara" Etiket="Randevu ara" Arandi="Ara" />
</div>

@if (_listeHatasi is not null)
{
    <p class="hata" role="alert">@_listeHatasi</p>
}

@if (_takvim)
{
    <div class="hafta-cubugu">
        <button class="ikincil" @onclick="() => HaftayaGit(_haftaBasi.AddDays(-7))">‹ Önceki hafta</button>
        <button class="ikincil" @onclick="() => HaftayaGit(Bicim.HaftaBasi(DateTime.Today))">Bu hafta</button>
        <button class="ikincil" @onclick="() => HaftayaGit(_haftaBasi.AddDays(7))">Sonraki hafta ›</button>
        <strong>@Bicim.HaftaAraligi(_haftaBasi)</strong>
    </div>

    <div class="takvim">
        @for (var i = 0; i < 7; i++)
        {
            var gun = _haftaBasi.AddDays(i);
            var gununRandevulari = (_sayfa?.Ogeler ?? []).Where(r => r.RandevuTarihi.ToLocalTime().Date == gun).ToList();

            <section class="takvim-gunu @(gun == DateTime.Today ? "bugun" : "")" @key="gun">
                <header>
                    <span>@Bicim.GunBasligi(gun)</span>
                    <button class="ikincil" title="Bu güne randevu ekle" aria-label="@Bicim.GunBasligi(gun) gününe randevu ekle"
                            @onclick="() => YeniAc(gun)">+</button>
                </header>

                @foreach (var randevu in gununRandevulari)
                {
                    <button class="takvim-randevusu @Bicim.TakvimSinifi(randevu.Durum)" @key="randevu.Id" @onclick="() => DuzenleAc(randevu)">
                        <span class="saat">@Bicim.SaatAraligi(randevu.RandevuTarihi, randevu.SureDakika)</span>
                        <span>@randevu.MusteriAdi</span>
                        @if (randevu.TeknisyenAdi is not null)
                        {
                            <span class="soluk">@randevu.TeknisyenAdi</span>
                        }
                    </button>
                }

                @if (gununRandevulari.Count == 0)
                {
                    <p class="soluk">—</p>
                }
            </section>
        }
    </div>
}
else if (_sayfa is null)
{
    <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
}
else if (_sayfa.Ogeler.Count == 0)
{
    <p class="soluk">@BosListeMetni</p>
}
else
{
    <table class="tablo">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Müşteri</th>
                <th>Teknisyen</th>
                <th>Açıklama</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var randevu in _sayfa.Ogeler)
            {
                <tr @key="randevu.Id">
                    <td class="dar">@Bicim.Tarih(randevu.RandevuTarihi)<br /><span class="soluk">@randevu.SureDakika dk</span></td>
                    <td>@randevu.MusteriAdi<br /><span class="soluk">@randevu.MusteriTelefonu</span></td>
                    <td>@(randevu.TeknisyenAdi ?? "—")</td>
                    <td class="uzun-metin">@(randevu.Aciklama ?? "—")</td>
                    <td><span class="@Bicim.DurumSinifi(randevu.Durum)">@Bicim.Durum(randevu.Durum)</span></td>
                    <td class="islemler">
                        @if (randevu.Durum == RandevuDurumu.Planlandi)
                        {
                            <button class="ikincil" @onclick="() => DurumuDegistir(randevu, RandevuDurumu.Tamamlandi)">Tamamla</button>
                            <button class="ikincil" @onclick="() => DurumuDegistir(randevu, RandevuDurumu.IptalEdildi)">İptal et</button>
                        }
                        else
                        {
                            <button class="ikincil" @onclick="() => DurumuDegistir(randevu, RandevuDurumu.Planlandi)">Yeniden planla</button>
                        }
                        <button class="ikincil" @onclick="() => DuzenleAc(randevu)">Düzenle</button>
                        @if (Oturum.AdminMi)
                        {
                            <button class="tehlike" @onclick="() => _silinecek = randevu">Sil</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="sayfalama">
        <span class="soluk">@_sayfa.Toplam kayıt</span>
        @if (SayfaSayisi > 1)
        {
            <button class="ikincil" @onclick="() => SayfayaGit(_sayfaNo - 1)" disabled="@(_sayfaNo <= 1)">Önceki</button>
            <span>@_sayfaNo / @SayfaSayisi</span>
            <button class="ikincil" @onclick="() => SayfayaGit(_sayfaNo + 1)" disabled="@(_sayfaNo >= SayfaSayisi)">Sonraki</button>
        }
    </div>
}

@if (_formAcik)
{
    <Pencere Baslik="@(_duzenlenen is null ? "Yeni randevu" : "Randevuyu düzenle")" Genis="true" KapatIstendi="FormuKapat">
        <form @onsubmit="Kaydet">
            <label>Müşteri</label>
            <MusteriSecici Secili="_musteri" SeciliChanged="MusteriSecildi" />

            <div class="yan-yana">
                <div>
                    <label for="r-tarih">Tarih ve saat</label>
                    <input id="r-tarih" type="datetime-local" @bind="_tarih" />
                </div>
                <div>
                    <label for="r-sure">Süre</label>
                    <select id="r-sure" @bind="_sure">
                        @foreach (var sure in SureSecenekleri)
                        {
                            <option value="@sure">@Bicim.Sure(sure)</option>
                        }
                    </select>
                </div>
            </div>

            <label for="r-teknisyen">Teknisyen (isteğe bağlı)</label>
            <PersonelSecimi ElemanId="r-teknisyen" @bind-Secili="_teknisyenId"
                            MevcutId="@_duzenlenen?.TeknisyenId" MevcutAd="@_duzenlenen?.TeknisyenAdi" />

            <label for="r-kayit">İlgili servis kaydı (isteğe bağlı)</label>
            <select id="r-kayit" @bind="_servisKaydiId" disabled="@(_musteri is null)">
                <option value="">— Yok —</option>
                @foreach (var kayit in _musterininKayitlari)
                {
                    <option value="@kayit.Id">@Bicim.Tarih(kayit.OlusturmaTarihi) – @kayit.CihazBilgisi</option>
                }
            </select>

            <label for="r-aciklama">Açıklama (isteğe bağlı)</label>
            <textarea id="r-aciklama" rows="3" @bind="_aciklama" @bind:event="oninput"></textarea>

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="FormuKapat" />
        </form>
    </Pencere>
}

@if (_silinecek is not null)
{
    <SilmeOnayi Baslik="Randevuyu sil" Hata="@_silmeHatasi" Mesgul="_kaydediliyor" Onayla="Sil" Vazgec="SilmeyiKapat">
        <strong>@_silinecek.MusteriAdi</strong> için @Bicim.Tarih(_silinecek.RandevuTarihi) randevusu kalıcı olarak silinecek.
        Randevu gerçekleşmeyecekse silmek yerine iptal edin.
    </SilmeOnayi>
}

@code {
    private const int SayfaBoyutu = 20;
    private const int TakvimBoyutu = 200;
    private static readonly int[] StandartSureler = [30, 60, 90, 120, 180, 240];

    private Sayfa<RandevuYaniti>? _sayfa;
    private int _sayfaNo = 1;
    private string _arama = "";
    // Sayfa, yaklaşan işleri göstermek için planlanmış randevularla açılır.
    private string _durum = RandevuDurumu.Planlandi.ToString();
    private string? _listeHatasi;
    private bool _yukleniyor;

    private bool _takvim;
    private DateTime _haftaBasi = Bicim.HaftaBasi(DateTime.Today);

    private bool _formAcik;
    private RandevuYaniti? _duzenlenen;
    private MusteriYaniti? _musteri;
    private DateTime? _tarih;
    private int _sure = RandevuKurallari.VarsayilanSure;
    private string _teknisyenId = "";
    private string _servisKaydiId = "";
    private string _aciklama = "";
    private IReadOnlyList<ServisKaydiYaniti> _musterininKayitlari = [];
    private string? _formHatasi;
    private bool _kaydediliyor;

    private RandevuYaniti? _silinecek;
    private string? _silmeHatasi;

    private int SayfaSayisi => _sayfa is null ? 1 : (int)Math.Max(1, Math.Ceiling(_sayfa.Toplam / (double)_sayfa.Boyut));

    // Düzenlenen randevunun süresi standart seçeneklerden biri değilse listeye eklenir ki kaybolmasın.
    private IEnumerable<int> SureSecenekleri => StandartSureler.Append(_sure).Distinct().Order();

    private string BosListeMetni =>
        _arama.Length > 0 ? "Aramayla eşleşen randevu yok."
        : _durum == RandevuDurumu.Planlandi.ToString() ? "Planlanmış randevu yok."
        : _durum.Length > 0 ? "Bu durumda randevu yok."
        : "Henüz randevu yok.";

    protected override Task OnInitializedAsync() => Yukle();

    private async Task Yukle()
    {
        var sorgu = $"arama={Uri.EscapeDataString(_arama)}";
        if (_durum.Length > 0) sorgu += $"&durum={_durum}";

        // Takvim seçili haftanın tamamını tek seferde ister; liste sayfalanır.
        sorgu += _takvim
            ? $"&baslangic={Bicim.SorguTarihi(_haftaBasi)}&bitis={Bicim.SorguTarihi(_haftaBasi.AddDays(7))}&boyut={TakvimBoyutu}"
            : $"&sayfa={_sayfaNo}&boyut={SayfaBoyutu}";

        _yukleniyor = true;
        var sonuc = await Api.Getir<Sayfa<RandevuYaniti>>($"api/randevular?{sorgu}");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (!sonuc.Basarili || sonuc.Deger is null) return;

        _sayfa = sonuc.Deger;

        // Son sayfadaki tek kayıt listeden çıktıysa boş sayfada kalmamak için geri dön.
        if (!_takvim && _sayfa.Ogeler.Count == 0 && _sayfaNo > 1)
        {
            _sayfaNo = SayfaSayisi;
            await Yukle();
        }
    }

    private Task GorunumSec(bool takvim)
    {
        if (_takvim == takvim) return Task.CompletedTask;

        _takvim = takvim;
        _sayfa = null;
        _sayfaNo = 1;
        return Yukle();
    }

    private Task HaftayaGit(DateTime haftaBasi)
    {
        _haftaBasi = haftaBasi;
        return Yukle();
    }

    private Task Ara(string arama)
    {
        _arama = arama;
        return SuzgecDegisti();
    }

    private Task SuzgecDegisti()
    {
        _sayfaNo = 1;
        return Yukle();
    }

    private Task SayfayaGit(int sayfaNo)
    {
        _sayfaNo = Math.Clamp(sayfaNo, 1, SayfaSayisi);
        return Yukle();
    }

    private async Task DurumuDegistir(RandevuYaniti randevu, RandevuDurumu durum)
    {
        var sonuc = await Api.Guncelle<RandevuYaniti>($"api/randevular/{randevu.Id}/durum", new RandevuDurumuIstegi(durum));
        _listeHatasi = sonuc.Hata;
        if (sonuc.Basarili) await Yukle();
    }

    // gun verilirse (takvimdeki + düğmesi) form o günün sabahına ayarlı açılır.
    private Task YeniAc(DateTime? gun) => FormuAc(null, gun?.AddHours(9));

    private Task DuzenleAc(RandevuYaniti randevu) => FormuAc(randevu, null);

    private async Task FormuAc(RandevuYaniti? randevu, DateTime? onerilenTarih)
    {
        _duzenlenen = randevu;
        // Seçici yalnızca ad ve telefonu gösterir; randevudaki kopya bunun için yeterlidir.
        _musteri = randevu is null
            ? null
            : new MusteriYaniti(randevu.MusteriId, randevu.MusteriAdi, randevu.MusteriTelefonu, null, null, default);
        _tarih = randevu?.RandevuTarihi.ToLocalTime() ?? onerilenTarih;
        _sure = randevu?.SureDakika ?? RandevuKurallari.VarsayilanSure;
        _teknisyenId = randevu?.TeknisyenId ?? "";
        _servisKaydiId = randevu?.ServisKaydiId ?? "";
        _aciklama = randevu?.Aciklama ?? "";
        _formHatasi = null;
        _musterininKayitlari = [];
        _formAcik = true;

        await MusterininKayitlariniYukle();
    }

    private async Task MusteriSecildi(MusteriYaniti? musteri)
    {
        _musteri = musteri;
        _servisKaydiId = "";
        _formHatasi = null;
        await MusterininKayitlariniYukle();
    }

    private async Task MusterininKayitlariniYukle()
    {
        _musterininKayitlari = [];
        if (_musteri is null) return;

        var sonuc = await Api.Getir<Sayfa<ServisKaydiYaniti>>($"api/servis-kayitlari?musteriId={_musteri.Id}&boyut=50");
        _musterininKayitlari = sonuc.Deger?.Ogeler ?? [];
    }

    private void FormuKapat() => _formAcik = false;

    private async Task Kaydet()
    {
        if (_kaydediliyor) return;

        if (_musteri is null)
        {
            _formHatasi = "Müşteri seçilmeli.";
            return;
        }

        if (_tarih is null)
        {
            _formHatasi = "Tarih ve saat seçilmeli.";
            return;
        }

        // Formdaki saat bilgisayarın saat dilimindedir; API'ye UTC gönderilir.
        var tarih = DateTime.SpecifyKind(_tarih.Value, DateTimeKind.Local).ToUniversalTime();
        var istek = new RandevuIstegi(_musteri.Id,
            _teknisyenId.Length > 0 ? _teknisyenId : null,
            _servisKaydiId.Length > 0 ? _servisKaydiId : null,
            tarih,
            _sure,
            string.IsNullOrWhiteSpace(_aciklama) ? null : _aciklama.Trim());

        _kaydediliyor = true;
        var sonuc = _duzenlenen is null
            ? await Api.Ekle<RandevuYaniti>("api/randevular", istek)
            : await Api.Guncelle<RandevuYaniti>($"api/randevular/{_duzenlenen.Id}", istek);
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _formAcik = false;
        await Yukle();
    }

    private void SilmeyiKapat()
    {
        _silinecek = null;
        _silmeHatasi = null;
    }

    private async Task Sil()
    {
        if (_silinecek is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = await Api.Sil($"api/randevular/{_silinecek.Id}");
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _silmeHatasi = sonuc.Hata;
            return;
        }

        SilmeyiKapat();
        await Yukle();
    }
}
