@page "/servis-kayitlari"
@inject ApiIstemcisi Api

<h1>Servis Kayıtları</h1>

<div class="arac-cubugu">
    <button @onclick="YeniAc">Yeni kayıt</button>

    <select class="suzgec" aria-label="Duruma göre süz" @bind="_durum" @bind:after="SuzgecDegisti">
        <option value="">Tüm durumlar</option>
        @foreach (var durum in Enum.GetValues<ServisDurumu>())
        {
            <option value="@durum">@Bicim.Durum(durum)</option>
        }
    </select>

    <select class="suzgec" aria-label="Faturaya göre süz" @bind="_fatura" @bind:after="SuzgecDegisti">
        <option value="@FaturaSuzgeci.Hepsi">Tüm kayıtlar</option>
        <option value="@FaturaSuzgeci.Faturali">Faturası olanlar</option>
        <option value="@FaturaSuzgeci.Odenmemis">Ödenmemiş faturalar</option>
        <option value="@FaturaSuzgeci.Odenmis">Ödenmiş faturalar</option>
    </select>

    <AramaKutusu YerTutucu="Müşteri, kayıt no, cihaz, seri no ara" Etiket="Servis kaydı ara" Arandi="Ara" />
</div>

@if (_listeHatasi is not null)
{
    <p class="hata" role="alert">@_listeHatasi</p>
}

@if (_sayfa is null)
{
    <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
}
else if (_sayfa.Ogeler.Count == 0)
{
    <p class="soluk">@(SuzgecVar ? "Süzgeçle eşleşen servis kaydı yok." : "Henüz servis kaydı yok.")</p>
}
else
{
    <table class="tablo">
        <thead>
            <tr>
                <th>Kayıt</th>
                <th>Müşteri</th>
                <th>Cihaz</th>
                <th>Teknisyen</th>
                <th>Durum</th>
                <th>Fatura</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kayit in _sayfa.Ogeler)
            {
                <tr @key="kayit.Id">
                    <td class="dar">@kayit.No<br /><span class="soluk">@Bicim.Tarih(kayit.OlusturmaTarihi)</span></td>
                    <td>@kayit.MusteriAdi<br /><span class="soluk">@kayit.MusteriTelefonu</span></td>
                    <td class="uzun-metin">
                        @kayit.CihazAdi
                        @if (kayit.GarantiKapsaminda)
                        {
                            <span class="rozet">garantili</span>
                        }
                    </td>
                    <td>@(kayit.TeknisyenAdi ?? "—")</td>
                    <td><span class="@Bicim.DurumSinifi(kayit.Durum)">@Bicim.Durum(kayit.Durum)</span></td>
                    <td class="dar">
                        @if (kayit.Fatura is { } fatura)
                        {
                            @Bicim.Para(fatura.Tutar)<br />
                            <span class="@(fatura.OdendiMi ? "durum iyi" : "durum kotu")">@(fatura.OdendiMi ? "Ödendi" : "Ödenmedi")</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="islemler">
                        <button class="ikincil" @onclick="() => DetayAc(kayit)">Aç</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <SayfaGezgini Sayfa="_sayfa" Birim="kayıt" SayfaIstendi="SayfayaGit" />
}

@if (_formAcik)
{
    <ServisKaydiFormu Kayit="_duzenlenen" Vazgec="FormuKapat" Kaydedildi="Kaydedildi" />
}
else if (_acik is not null)
{
    <ServisKaydiDetayi Kayit="_acik" Degisti="DetayDegisti" Silindi="DetaySilindi"
                       DuzenleIstendi="DuzenleAc" Kapat="DetayiKapat" />
}

@code {
    private const int SayfaBoyutu = 20;

    private Sayfa<ServisKaydiYaniti>? _sayfa;
    private int _sayfaNo = 1;
    private string _arama = "";
    private string _durum = "";
    private FaturaSuzgeci _fatura = FaturaSuzgeci.Hepsi;
    private string? _listeHatasi;
    private bool _yukleniyor;

    private ServisKaydiYaniti? _acik;
    private ServisKaydiYaniti? _duzenlenen;
    private bool _formAcik;

    private bool SuzgecVar => _arama.Length > 0 || _durum.Length > 0 || _fatura != FaturaSuzgeci.Hepsi;
    private int SayfaSayisi => _sayfa?.SayfaSayisi ?? 1;

    protected override Task OnInitializedAsync() => Yukle();

    private async Task Yukle()
    {
        var sorgu = $"arama={Uri.EscapeDataString(_arama)}&fatura={_fatura}&sayfa={_sayfaNo}&boyut={SayfaBoyutu}";
        if (_durum.Length > 0) sorgu += $"&durum={_durum}";

        _yukleniyor = true;
        var sonuc = await Api.Getir<Sayfa<ServisKaydiYaniti>>($"api/servis-kayitlari?{sorgu}");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (!sonuc.Basarili || sonuc.Deger is null) return;

        _sayfa = sonuc.Deger;

        // Son sayfadaki tek kayıt listeden çıktıysa boş sayfada kalmamak için geri dön.
        if (_sayfa.Ogeler.Count == 0 && _sayfaNo > 1)
        {
            _sayfaNo = SayfaSayisi;
            await Yukle();
        }
    }

    private Task Ara(string arama)
    {
        _arama = arama;
        return SuzgecDegisti();
    }

    private Task SuzgecDegisti()
    {
        _sayfaNo = 1;
        return Yukle();
    }

    private Task SayfayaGit(int sayfaNo)
    {
        _sayfaNo = Math.Clamp(sayfaNo, 1, SayfaSayisi);
        return Yukle();
    }

    private void YeniAc()
    {
        _duzenlenen = null;
        _formAcik = true;
    }

    private void DetayAc(ServisKaydiYaniti kayit) => _acik = kayit;

    private void DetayiKapat() => _acik = null;

    private void DuzenleAc()
    {
        _duzenlenen = _acik;
        _formAcik = true;
    }

    private void FormuKapat() => _formAcik = false;

    // Kaydedilen kayıt ayrıntı penceresinde açılır; yeni kayıtta durum ve fatura oradan yönetilir.
    private Task Kaydedildi(ServisKaydiYaniti kayit)
    {
        _formAcik = false;
        _acik = kayit;
        return Yukle();
    }

    private Task DetayDegisti(ServisKaydiYaniti kayit)
    {
        _acik = kayit;
        return Yukle();
    }

    private Task DetaySilindi()
    {
        _acik = null;
        return Yukle();
    }
}
