@page "/stok"
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<h1>Stok</h1>

<div class="arac-cubugu">
    @if (Oturum.AdminMi)
    {
        <button @onclick="YeniAc">Stok kartı</button>
    }

    <select class="suzgec" aria-label="Stok durumuna göre süz" @bind="_yalnizAzalan" @bind:after="SuzgecDegisti">
        <option value="@false">Tüm parçalar</option>
        <option value="@true">Stoğu azalanlar</option>
    </select>

    <ExcelDugmesi Yol="api/parcalar/disa-aktar" DosyaAdi="Stok" />

    <AramaKutusu YerTutucu="Parça adı veya stok kodu ara" Etiket="Parça ara" Arandi="Ara" />
</div>

@if (_listeHatasi is not null)
{
    <p class="hata" role="alert">@_listeHatasi</p>
}

@if (_sayfa is null)
{
    <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
}
else if (_sayfa.Ogeler.Count == 0)
{
    <p class="soluk">
        @(_arama.Length > 0 || _yalnizAzalan ? "Süzgeçle eşleşen parça bulunamadı."
            : Oturum.AdminMi ? "Kayıtlı stok kartı bulunmuyor. “Stok kartı” düğmesiyle ekleyebilirsiniz." : "Kayıtlı stok kartı bulunmuyor.")
    </p>
}
else
{
    <table class="tablo">
        <thead>
            <tr>
                <th>Parça</th>
                <th>Stok kodu</th>
                <th>Birim fiyat</th>
                <th>Stok</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var parca in _sayfa.Ogeler)
            {
                <tr @key="parca.Id">
                    <td>@parca.Ad</td>
                    <td>@(parca.Kod ?? "—")</td>
                    <td class="dar">@Bicim.Para(parca.BirimFiyat)</td>
                    <td class="dar">
                        <strong>@parca.StokAdedi</strong>
                        @if (parca.AzaldiMi)
                        {
                            <span class="durum kotu bosluklu">@(parca.StokAdedi == 0 ? "tükendi" : "azaldı")</span>
                        }
                    </td>
                    <td class="islemler">
                        <button class="ikincil" @onclick="() => HareketleriAc(parca)">Hareketler</button>
                        @if (Oturum.AdminMi)
                        {
                            <button class="ikincil" @onclick="() => StokAc(parca)">Stok girişi</button>
                            <button class="ikincil" @onclick="() => DuzenleAc(parca)">Düzenle</button>
                            <button class="tehlike" @onclick="() => _silinecek = parca">Sil</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <SayfaGezgini Sayfa="_sayfa" Birim="parça" SayfaIstendi="SayfayaGit" />
}

@if (_form is not null)
{
    <Pencere Baslik="@(_duzenlenen is null ? "Stok kartı" : "Parçayı düzenle")" KapatIstendi="FormuKapat">
        <form @onsubmit="Kaydet">
            <label for="p-ad">Parça adı</label>
            <input id="p-ad" @bind="_form.Ad" @bind:event="oninput" maxlength="120" autocomplete="off" />

            <label for="p-kod">Stok kodu (isteğe bağlı)</label>
            <input id="p-kod" @bind="_form.Kod" @bind:event="oninput" maxlength="60" autocomplete="off" />

            <div class="iki-sutun">
                <div>
                    <label for="p-fiyat">Birim fiyat (₺, KDV dahil)</label>
                    <input id="p-fiyat" @bind="_form.BirimFiyat" @bind:event="oninput" inputmode="decimal" placeholder="250" autocomplete="off" />
                </div>
                <div>
                    <label for="p-kritik">Kritik stok seviyesi</label>
                    <input id="p-kritik" type="number" min="0" @bind="_form.KritikSeviye" />
                </div>
            </div>
            <p class="soluk aciklama">Stok kritik seviyeye inince parça “azaldı” olarak işaretlenir ve ana sayfada uyarı çıkar.</p>

            @if (_duzenlenen is null)
            {
                <label for="p-stok">Başlangıç stoğu</label>
                <input id="p-stok" type="number" min="0" @bind="_form.BaslangicStogu" />
            }

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="FormuKapat" />
        </form>
    </Pencere>
}

@if (_stokParcasi is not null)
{
    <Pencere Baslik="@($"Stok girişi – {_stokParcasi.Ad}")" KapatIstendi="StokuKapat">
        <form @onsubmit="StokuKaydet">
            <p class="soluk">Mevcut stok: <strong>@_stokParcasi.StokAdedi</strong></p>

            <label for="h-adet">Adet (sayım düzeltmesi için eksi değer girin)</label>
            <input id="h-adet" type="number" @bind="_stokAdedi" />

            <label for="h-aciklama">Açıklama (isteğe bağlı)</label>
            <input id="h-aciklama" @bind="_stokAciklamasi" @bind:event="oninput" maxlength="200"
                   placeholder="Örn. tedarikçi faturası, sayım farkı" autocomplete="off" />

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="StokuKapat" />
        </form>
    </Pencere>
}

@if (_hareketParcasi is not null)
{
    <Pencere Baslik="@($"Stok hareketleri – {_hareketParcasi.Ad}")" Genis="true" KapatIstendi="() => _hareketParcasi = null">
        @if (_hareketHatasi is not null)
        {
            <p class="hata" role="alert">@_hareketHatasi</p>
        }
        else if (_hareketler is null)
        {
            <p class="soluk">Yükleniyor…</p>
        }
        else if (_hareketler.Count == 0)
        {
            <p class="soluk">Bu parçanın stok hareketi yok.</p>
        }
        else
        {
            <table class="tablo sik">
                <thead>
                    <tr><th>Tarih</th><th>Adet</th><th>Açıklama</th><th>Kayıt</th><th>Yapan</th></tr>
                </thead>
                <tbody>
                    @foreach (var hareket in _hareketler)
                    {
                        <tr @key="hareket.Id">
                            <td class="dar">@Bicim.Tarih(hareket.Tarih)</td>
                            <td class="dar"><span class="@(hareket.Adet > 0 ? "durum iyi" : "durum kotu")">@hareket.Adet.ToString("+#;-#")</span></td>
                            <td>@hareket.Aciklama</td>
                            <td class="dar">@(hareket.ServisKaydiNo ?? "—")</td>
                            <td>@hareket.KullaniciAdi</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <footer>
            <button type="button" class="ikincil" @onclick="() => _hareketParcasi = null">Kapat</button>
        </footer>
    </Pencere>
}

@if (_silinecek is not null)
{
    <SilmeOnayi Baslik="Parçayı sil" Hata="@_silmeHatasi" Mesgul="_siliniyor" Onayla="Sil" Vazgec="SilmeyiKapat">
        <strong>@_silinecek.Ad</strong> stok kartı silinecek. Parçanın kullanıldığı eski servis kayıtları değişmez.
    </SilmeOnayi>
}

@code {
    private const int SayfaBoyutu = 20;

    private class ParcaFormu
    {
        public string Ad { get; set; } = "";
        public string Kod { get; set; } = "";
        public string BirimFiyat { get; set; } = "";
        public int KritikSeviye { get; set; } = 1;
        public int BaslangicStogu { get; set; }
    }

    private Sayfa<ParcaYaniti>? _sayfa;
    private int _sayfaNo = 1;
    private string _arama = "";
    private bool _yalnizAzalan;
    private string? _listeHatasi;
    private bool _yukleniyor;

    private ParcaFormu? _form;
    private ParcaYaniti? _duzenlenen;
    private string? _formHatasi;
    private bool _kaydediliyor;

    private ParcaYaniti? _stokParcasi;
    private int _stokAdedi = 1;
    private string _stokAciklamasi = "";

    private ParcaYaniti? _hareketParcasi;
    private IReadOnlyList<StokHareketiYaniti>? _hareketler;
    private string? _hareketHatasi;

    private ParcaYaniti? _silinecek;
    private string? _silmeHatasi;
    private bool _siliniyor;

    private int SayfaSayisi => _sayfa?.SayfaSayisi ?? 1;

    protected override Task OnInitializedAsync() => Yukle();

    private async Task Yukle()
    {
        _yukleniyor = true;
        var sonuc = await Api.Getir<Sayfa<ParcaYaniti>>(
            $"api/parcalar?arama={Uri.EscapeDataString(_arama)}&azalan={(_yalnizAzalan ? "true" : "false")}&sayfa={_sayfaNo}&boyut={SayfaBoyutu}");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (!sonuc.Basarili || sonuc.Deger is null) return;

        _sayfa = sonuc.Deger;

        // Son sayfadaki tek parça listeden çıktıysa boş sayfada kalmamak için geri dön.
        if (_sayfa.Ogeler.Count == 0 && _sayfaNo > 1)
        {
            _sayfaNo = SayfaSayisi;
            await Yukle();
        }
    }

    private Task Ara(string arama)
    {
        _arama = arama;
        return SuzgecDegisti();
    }

    private Task SuzgecDegisti()
    {
        _sayfaNo = 1;
        return Yukle();
    }

    private Task SayfayaGit(int sayfaNo)
    {
        _sayfaNo = Math.Clamp(sayfaNo, 1, SayfaSayisi);
        return Yukle();
    }

    private void YeniAc()
    {
        _duzenlenen = null;
        _formHatasi = null;
        _form = new ParcaFormu();
    }

    private void DuzenleAc(ParcaYaniti parca)
    {
        _duzenlenen = parca;
        _formHatasi = null;
        _form = new ParcaFormu
        {
            Ad = parca.Ad,
            Kod = parca.Kod ?? "",
            BirimFiyat = Bicim.ParaGirdisi(parca.BirimFiyat),
            KritikSeviye = parca.KritikSeviye
        };
    }

    private void FormuKapat() => _form = null;

    private async Task Kaydet()
    {
        if (_form is null || _kaydediliyor) return;

        if (!Bicim.ParaOku(_form.BirimFiyat, out var fiyat))
        {
            _formHatasi = "Geçerli bir birim fiyat girin (örn. 250 ya da 249,90).";
            return;
        }

        if (_form.BaslangicStogu < 0)
        {
            _formHatasi = "Başlangıç stoğu eksi olamaz.";
            return;
        }

        var istek = new ParcaIstegi(_form.Ad.Trim(), Metin.BosIseNull(_form.Kod),
            fiyat, _form.KritikSeviye);

        _kaydediliyor = true;
        var sonuc = _duzenlenen is null
            ? await Api.Ekle<ParcaYaniti>("api/parcalar", istek)
            : await Api.Guncelle<ParcaYaniti>($"api/parcalar/{_duzenlenen.Id}", istek);

        // Yeni kartın başlangıç stoğu ayrı bir stok girişidir; böylece hareket geçmişinde de görünür.
        if (sonuc is { Basarili: true, Deger: not null } && _duzenlenen is null && _form.BaslangicStogu > 0)
        {
            var giris = await Api.Ekle<ParcaYaniti>($"api/parcalar/{sonuc.Deger.Id}/stok",
                new StokHareketiIstegi(_form.BaslangicStogu, "Başlangıç stoğu"));
            if (!giris.Basarili)
            {
                _kaydediliyor = false;
                _form = null;
                _listeHatasi = $"Parça eklendi ama başlangıç stoğu yazılamadı: {giris.Hata}";
                await Yukle();
                return;
            }
        }
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _form = null;
        await Yukle();
    }

    private void StokAc(ParcaYaniti parca)
    {
        _stokParcasi = parca;
        _stokAdedi = 1;
        _stokAciklamasi = "";
        _formHatasi = null;
    }

    private void StokuKapat() => _stokParcasi = null;

    private async Task StokuKaydet()
    {
        if (_stokParcasi is null || _kaydediliyor) return;

        if (_stokAdedi == 0)
        {
            _formHatasi = "Adet sıfır olamaz.";
            return;
        }

        _kaydediliyor = true;
        var sonuc = await Api.Ekle<ParcaYaniti>($"api/parcalar/{_stokParcasi.Id}/stok",
            new StokHareketiIstegi(_stokAdedi, Metin.BosIseNull(_stokAciklamasi)));
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _stokParcasi = null;
        await Yukle();
    }

    private async Task HareketleriAc(ParcaYaniti parca)
    {
        _hareketParcasi = parca;
        _hareketler = null;
        _hareketHatasi = null;

        var sonuc = await Api.Getir<IReadOnlyList<StokHareketiYaniti>>($"api/parcalar/{parca.Id}/hareketler");
        _hareketHatasi = sonuc.Hata;
        if (sonuc.Basarili) _hareketler = sonuc.Deger;
    }

    private void SilmeyiKapat()
    {
        _silinecek = null;
        _silmeHatasi = null;
    }

    private async Task Sil()
    {
        if (_silinecek is null) return;

        _siliniyor = true;
        var sonuc = await Api.Sil($"api/parcalar/{_silinecek.Id}");
        _siliniyor = false;

        if (!sonuc.Basarili)
        {
            _silmeHatasi = sonuc.Hata;
            return;
        }

        SilmeyiKapat();
        await Yukle();
    }
}
