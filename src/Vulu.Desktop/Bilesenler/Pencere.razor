@* Sayfanın üzerinde açılan iletişim penceresi. *@

<div class="perde" @onclick="Kapat">
    <div class="pencere @(Genis ? "genis" : "")" role="dialog" aria-modal="true" aria-label="@Baslik"
         @onclick:stopPropagation="true">
        <header>
            <h2>@Baslik</h2>
            <button type="button" class="kapat" aria-label="Kapat" @onclick="Kapat">×</button>
        </header>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Baslik { get; set; } = "";
    [Parameter] public bool Genis { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback KapatIstendi { get; set; }

    private Task Kapat() => KapatIstendi.InvokeAsync();
}
