@* Bir listeyi Excel dosyası olarak indirip açan düğme. Dosya İndirilenler klasörüne kaydedilir. *@
@inject ApiIstemcisi Api

<button type="button" class="ikincil" disabled="@_mesgul" @onclick="Aktar">@(_mesgul ? "Hazırlanıyor…" : Metin)</button>
@if (_hata is not null)
{
    <span class="hata satir-ici" role="alert">@_hata</span>
}
else if (_kaydedilen is not null)
{
    <span class="soluk satir-ici" role="status">İndirilenler klasörüne kaydedildi: @_kaydedilen</span>
}

@code {
    // API'deki dışa aktarma ucu (sorgu dizgisiyle birlikte) ve kaydedilecek dosyanın uzantısız adı.
    [Parameter, EditorRequired] public string Yol { get; set; } = "";
    [Parameter, EditorRequired] public string DosyaAdi { get; set; } = "";
    [Parameter] public string Metin { get; set; } = "Excel'e aktar";

    private bool _mesgul;
    private string? _hata;
    private string? _kaydedilen;

    private async Task Aktar()
    {
        _mesgul = true;
        _hata = _kaydedilen = null;
        var sonuc = await Api.Indir(Yol);
        _mesgul = false;

        if (!sonuc.Basarili || sonuc.Deger is null)
        {
            _hata = sonuc.Hata;
            return;
        }

        (_kaydedilen, _hata) = BelgeAcici.KaydetVeAc($"{DosyaAdi}-{DateTime.Today:yyyy-MM-dd}.xlsx", sonuc.Deger);
    }
}
