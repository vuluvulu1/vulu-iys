@* Vulu yöneticisinin tek bir işletme üzerindeki işlemleri: ad ve iletişim bilgileri, yönetici şifresi, kalıcı silme. *@
@inject ApiIstemcisi Api

<Pencere Baslik="@Isletme.Ad" Genis="true" KapatIstendi="Kapat">
    <form @onsubmit="GeneliKaydet">
        <label for="y-ad">İşletme adı</label>
        <input id="y-ad" @bind="_ad" @bind:event="oninput" autocomplete="off" />

        <label for="y-adres">Adres</label>
        <textarea id="y-adres" rows="2" @bind="_adres" @bind:event="oninput"></textarea>

        <div class="iki-sutun">
            <div>
                <label for="y-telefon">Telefon</label>
                <input id="y-telefon" @bind="_telefon" @bind:event="oninput" inputmode="numeric" maxlength="11"
                       placeholder="03801234567" autocomplete="off" />
            </div>
            <div>
                <label for="y-eposta">E-posta</label>
                <input id="y-eposta" type="email" @bind="_eposta" @bind:event="oninput" autocomplete="off" />
            </div>
        </div>

        <label class="onay-kutusu">
            <input id="y-aktif" type="checkbox" @bind="_aktif" />
            İşletme açık
        </label>
        <p class="soluk aciklama">
            Askıya alınan işletmenin personeli giriş yapamaz ve açık oturumları kapanır; verisi silinmez.
        </p>

        <div class="bolum-dugmesi">
            @Bildirim(Bolum.Genel)
            <button type="submit" disabled="@_mesgul">Kaydet</button>
        </div>
    </form>

    <section class="bolum">
        <h3>Yönetici şifresini sıfırla</h3>
        <p class="soluk aciklama">
            İşletme yöneticisi şifresini unuttuğunda yenisini buradan verirsiniz. Diğer personelin şifresini
            işletmenin kendi yöneticisi değiştirir.
        </p>

        <form @onsubmit="SifreyiSifirla">
            <div class="iki-sutun">
                <div>
                    <label for="y-yonetici">Yönetici hesabı</label>
                    <select id="y-yonetici" @bind="_sifirlanacakId">
                        @foreach (var yonetici in _yoneticiler)
                        {
                            <option value="@yonetici.Id">
                                @yonetici.AdSoyad (@yonetici.KullaniciAdi)@(yonetici.AktifMi ? "" : " – devre dışı")
                            </option>
                        }
                    </select>
                </div>
                <div>
                    <label for="y-yeni-sifre">Yeni şifre</label>
                    <input id="y-yeni-sifre" type="password" @bind="_yeniSifre" @bind:event="oninput" autocomplete="new-password" />
                </div>
            </div>

            <div class="bolum-dugmesi">
                @Bildirim(Bolum.Sifre)
                <button type="submit" disabled="@(_mesgul || _yoneticiler.Count == 0)">Şifreyi sıfırla</button>
            </div>
        </form>
    </section>

    <section class="bolum">
        <h3>İşletmeyi kalıcı olarak sil</h3>

        @if (Isletme.AktifMi)
        {
            <p class="soluk aciklama">Silmek için önce işletmeyi askıya alın (yukarıdan “İşletme açık” işaretini kaldırıp kaydedin).</p>
        }
        else
        {
            <p class="aciklama">
                İşletmenin personeli, müşterileri, servis kayıtları, randevuları ve faturaları <strong>geri getirilemeyecek
                şekilde</strong> silinir. Onaylamak için işletme kodunu (<code>@Isletme.Kod</code>) yazın.
            </p>

            <form @onsubmit="KaliciSil">
                <label for="y-sil-kod">İşletme kodu</label>
                <input id="y-sil-kod" @bind="_silmeKodu" @bind:event="oninput" autocomplete="off" autocapitalize="none" spellcheck="false" />

                <div class="bolum-dugmesi">
                    @Bildirim(Bolum.Silme)
                    <button type="submit" class="tehlike" disabled="@(_mesgul || _silmeKodu.Trim() != Isletme.Kod)">Kalıcı olarak sil</button>
                </div>
            </form>
        }
    </section>

    <footer>
        <button type="button" class="ikincil" @onclick="Kapat">Kapat</button>
    </footer>
</Pencere>

@code {
    private enum Bolum { Genel, Sifre, Silme }

    [Parameter, EditorRequired] public IsletmeYaniti Isletme { get; set; } = null!;
    [Parameter] public EventCallback<IsletmeYaniti> Degisti { get; set; }
    [Parameter] public EventCallback Silindi { get; set; }
    [Parameter] public EventCallback Kapat { get; set; }

    private string _ad = "";
    private bool _aktif;
    private string _adres = "";
    private string _telefon = "";
    private string _eposta = "";

    private List<IsletmeYoneticisiOzeti> _yoneticiler = [];
    private string _sifirlanacakId = "";
    private string _yeniSifre = "";

    private string _silmeKodu = "";

    private bool _mesgul;
    private Bolum? _bildirimBolumu;
    private string? _hata;
    private string? _basari;
    private IsletmeYaniti? _alanlarinKaydi;

    private string Yol => $"api/platform/isletmeler/{Isletme.Id}";

    // Her bölümün sonucu kendi düğmesinin yanında gösterilir.
    private RenderFragment Bildirim(Bolum bolum) => __builder =>
    {
        if (_bildirimBolumu != bolum) return;

        if (_hata is not null)
        {
            <span class="hata satir-ici" role="alert">@_hata</span>
        }
        else if (_basari is not null)
        {
            <span class="durum iyi satir-ici" role="status">@_basari</span>
        }
    };

    protected override void OnParametersSet()
    {
        // Alanlar yalnızca kayıt değiştiğinde (bir işlem sonrası yenilendiğinde) doldurulur.
        if (ReferenceEquals(_alanlarinKaydi, Isletme)) return;
        _alanlarinKaydi = Isletme;

        _ad = Isletme.Ad;
        _aktif = Isletme.AktifMi;
        _adres = Isletme.Adres ?? "";
        _telefon = Isletme.Telefon ?? "";
        _eposta = Isletme.Eposta ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        var yoneticiler = await Api.Getir<List<IsletmeYoneticisiOzeti>>($"{Yol}/yoneticiler");
        _yoneticiler = yoneticiler.Deger ?? [];
        _sifirlanacakId = _yoneticiler.FirstOrDefault()?.Id ?? "";

        if (yoneticiler.Hata is { } hata)
            Bildir(Bolum.Sifre, hata, null);
    }

    private void Bildir(Bolum bolum, string? hata, string? basari)
    {
        _bildirimBolumu = bolum;
        _hata = hata;
        _basari = basari;
    }

    private async Task GeneliKaydet()
    {
        if (_mesgul) return;

        _mesgul = true;
        var sonuc = await Api.Guncelle<IsletmeYaniti>(Yol,
            new IsletmeDurumIstegi(_ad.Trim(), _aktif, _adres.Trim(), _telefon.Trim(), _eposta.Trim()));
        _mesgul = false;

        Bildir(Bolum.Genel, sonuc.Hata, sonuc.Basarili ? "Kaydedildi." : null);
        if (sonuc is { Basarili: true, Deger: not null })
            await Degisti.InvokeAsync(sonuc.Deger);
    }

    private async Task SifreyiSifirla()
    {
        if (_mesgul || _sifirlanacakId.Length == 0) return;

        _mesgul = true;
        var sonuc = await Api.Guncelle<object>($"{Yol}/yoneticiler/{_sifirlanacakId}/sifre", new SifreSifirlamaIstegi(_yeniSifre));
        _mesgul = false;

        Bildir(Bolum.Sifre, sonuc.Hata, sonuc.Basarili ? "Şifre değiştirildi; yeni şifreyi işletmeye iletin." : null);
        if (sonuc.Basarili) _yeniSifre = "";
    }

    private async Task KaliciSil()
    {
        if (_mesgul || _silmeKodu.Trim() != Isletme.Kod) return;

        _mesgul = true;
        var sonuc = await Api.Sil($"{Yol}?kod={Uri.EscapeDataString(_silmeKodu.Trim())}");
        _mesgul = false;

        if (!sonuc.Basarili)
        {
            Bildir(Bolum.Silme, sonuc.Hata, null);
            return;
        }

        await Silindi.InvokeAsync();
    }
}
