@* Müşteri sayısı çok olabileceği için açılır liste yerine arayarak seçilir. *@
@inject ApiIstemcisi Api

@if (Secili is not null)
{
    <div class="secili-musteri">
        <span><strong>@Secili.AdSoyad</strong> <span class="soluk">@Secili.Telefon</span></span>
        <button type="button" class="ikincil" @onclick="() => Sec(null)">Değiştir</button>
    </div>
}
else
{
    <AramaKutusu YerTutucu="Müşteri adı veya telefonu yazın" Etiket="Müşteri ara" Arandi="Ara" />

    @if (_hata is not null)
    {
        <p class="hata" role="alert">@_hata</p>
    }
    else if (_sonuclar is { Count: 0 })
    {
        <p class="soluk secim-bilgisi">Eşleşen müşteri yok. Önce Müşteriler sayfasından ekleyin.</p>
    }
    else if (_sonuclar is not null)
    {
        <ul class="secim-listesi">
            @foreach (var musteri in _sonuclar)
            {
                <li @key="musteri.Id">
                    <button type="button" @onclick="() => Sec(musteri)">
                        @musteri.AdSoyad <span class="soluk">@musteri.Telefon</span>
                    </button>
                </li>
            }
        </ul>
        @if (_toplam > _sonuclar.Count)
        {
            <p class="soluk secim-bilgisi">@(_toplam - _sonuclar.Count) müşteri daha var; aramayı daraltın.</p>
        }
    }
}

@code {
    private const int EnFazlaSonuc = 6;

    [Parameter] public MusteriYaniti? Secili { get; set; }
    [Parameter] public EventCallback<MusteriYaniti?> SeciliChanged { get; set; }

    private IReadOnlyList<MusteriYaniti>? _sonuclar;
    private long _toplam;
    private string? _hata;

    private async Task Ara(string arama)
    {
        if (arama.Length == 0)
        {
            _sonuclar = null;
            _hata = null;
            return;
        }

        var sonuc = await Api.Getir<Sayfa<MusteriYaniti>>(
            $"api/musteriler?arama={Uri.EscapeDataString(arama)}&boyut={EnFazlaSonuc}");
        _hata = sonuc.Hata;
        _sonuclar = sonuc.Deger?.Ogeler;
        _toplam = sonuc.Deger?.Toplam ?? 0;
    }

    private Task Sec(MusteriYaniti? musteri)
    {
        _sonuclar = null;
        return SeciliChanged.InvokeAsync(musteri);
    }
}
