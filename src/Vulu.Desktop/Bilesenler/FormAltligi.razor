@* Kayıt formlarının ortak alt bölümü: sunucudan gelen hata ve Vazgeç / Kaydet düğmeleri. *@

@if (Hata is not null)
{
    <p class="hata" role="alert">@Hata</p>
}

<footer>
    <button type="button" class="ikincil" @onclick="Vazgec">Vazgeç</button>
    <button type="submit" disabled="@Mesgul">@(Mesgul ? "Kaydediliyor…" : "Kaydet")</button>
</footer>

@code {
    [Parameter] public string? Hata { get; set; }
    [Parameter] public bool Mesgul { get; set; }
    [Parameter] public EventCallback Vazgec { get; set; }
}
