@* Oturumdaki kişinin kendi şifresini değiştirdiği pencere. *@
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<Pencere Baslik="Şifre değiştir" KapatIstendi="Kapat">
    @if (_degisti)
    {
        <p class="durum iyi" role="status">Şifreniz değiştirildi. Diğer cihazlardaki oturumlarınız kapatıldı.</p>
        <footer>
            <button type="button" @onclick="Kapat">Tamam</button>
        </footer>
    }
    else
    {
        <form @onsubmit="Kaydet">
            <label for="sd-mevcut">Mevcut şifre</label>
            <input id="sd-mevcut" type="password" @bind="_mevcut" @bind:event="oninput" autocomplete="current-password" />

            <label for="sd-yeni">Yeni şifre</label>
            <input id="sd-yeni" type="password" @bind="_yeni" @bind:event="oninput" autocomplete="new-password" />

            <label for="sd-tekrar">Yeni şifre (tekrar)</label>
            <input id="sd-tekrar" type="password" @bind="_tekrar" @bind:event="oninput" autocomplete="new-password" />

            <p class="soluk aciklama">En az @KullaniciKurallari.EnAzSifreUzunlugu karakter. Başka yerde kullanmadığınız bir şifre seçin.</p>

            <FormAltligi Hata="@_hata" Mesgul="_kaydediliyor" Vazgec="Kapat" />
        </form>
    }
</Pencere>

@code {
    [Parameter] public EventCallback Kapat { get; set; }

    private string _mevcut = "";
    private string _yeni = "";
    private string _tekrar = "";
    private string? _hata;
    private bool _kaydediliyor;
    private bool _degisti;

    private async Task Kaydet()
    {
        if (_kaydediliyor) return;

        if (_yeni != _tekrar)
        {
            _hata = "Yeni şifre ile tekrarı aynı değil.";
            return;
        }

        _kaydediliyor = true;
        var sonuc = await Api.Ekle<OturumYaniti>("api/kimlik/sifre", new SifreDegistirmeIstegi(_mevcut, _yeni));
        _kaydediliyor = false;

        // Şifreler bellekte gereğinden uzun tutulmaz.
        _mevcut = _yeni = _tekrar = "";

        if (!sonuc.Basarili || sonuc.Deger is null)
        {
            _hata = sonuc.Hata;
            return;
        }

        // Eski tokenlar artık geçersiz; sunucunun verdiği yeni oturumla devam edilir.
        Oturum.OturumuYenile(sonuc.Deger);
        _hata = null;
        _degisti = true;
    }
}
