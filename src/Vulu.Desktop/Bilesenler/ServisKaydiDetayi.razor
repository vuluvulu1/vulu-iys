@* Servis kaydının ayrıntı penceresi. Her sekme kendi bileşenindedir; ortak durum KayitIslemleri üzerinden paylaşılır. *@
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<Pencere Baslik="@($"Servis kaydı {Kayit.No}")" Genis="true" KapatIstendi="Kapat">
    <div class="sekmeler" role="tablist">
        @foreach (var sekme in Enum.GetValues<Sekme>())
        {
            <button type="button" role="tab" class="@(sekme == _sekme ? "" : "ikincil")"
                    aria-selected="@(sekme == _sekme ? "true" : "false")" @onclick="() => SekmeyeGec(sekme)">
                @SekmeAdi(sekme)
            </button>
        }
    </div>

    @switch (_sekme)
    {
        case Sekme.Genel:
            <KayitGenelSekmesi Kayit="Kayit" Islemler="_islemler" />
            break;
        case Sekme.Teklif:
            <KayitTeklifSekmesi Kayit="Kayit" Islemler="_islemler" />
            break;
        case Sekme.Fatura:
            <KayitFaturaSekmesi Kayit="Kayit" Islemler="_islemler" />
            break;
        default:
            <KayitGecmisSekmesi Kayit="Kayit" Islemler="_islemler" />
            break;
    }

    @if (_islemler.Hata is not null)
    {
        <p class="hata" role="alert">@_islemler.Hata</p>
    }

    <footer>
        @if (Oturum.AdminMi)
        {
            <button type="button" class="tehlike sola" disabled="@_islemler.Mesgul" @onclick="KaydiSil">
                @(_silmeOnayi ? "Silmeyi onayla" : "Kaydı sil")
            </button>
        }
        <button type="button" class="ikincil" disabled="@_islemler.Mesgul" @onclick="DuzenleIstendi">Düzenle</button>
        <button type="button" class="ikincil" @onclick="Kapat">Kapat</button>
    </footer>
</Pencere>

@code {
    private enum Sekme { Genel, Teklif, Fatura, Gecmis }

    [Parameter, EditorRequired] public ServisKaydiYaniti Kayit { get; set; } = null!;
    [Parameter] public EventCallback<ServisKaydiYaniti> Degisti { get; set; }
    [Parameter] public EventCallback Silindi { get; set; }
    [Parameter] public EventCallback DuzenleIstendi { get; set; }
    [Parameter] public EventCallback Kapat { get; set; }

    private KayitIslemleri _islemler = null!;
    private Sekme _sekme = Sekme.Genel;
    private bool _silmeOnayi;

    private static string SekmeAdi(Sekme sekme) => sekme switch
    {
        Sekme.Genel => "Genel",
        Sekme.Teklif => "Teklif ve parçalar",
        Sekme.Fatura => "Fatura",
        _ => "Geçmiş"
    };

    protected override void OnInitialized() =>
        _islemler = new KayitIslemleri(Api, kayit => Degisti.InvokeAsync(kayit), StateHasChanged);

    protected override void OnParametersSet() => _islemler.KayitId = Kayit.Id;

    private void SekmeyeGec(Sekme sekme)
    {
        _sekme = sekme;
        _silmeOnayi = false;
        _islemler.HatayiGoster(null);
    }

    // Silme iki adımlıdır: ilk tıklama onay ister, ikincisi siler.
    private async Task KaydiSil()
    {
        if (!_silmeOnayi)
        {
            _silmeOnayi = true;
            return;
        }

        _silmeOnayi = false;
        var sonuc = await _islemler.Yap(api => api.Sil(_islemler.Yol));
        if (sonuc.Basarili)
            await Silindi.InvokeAsync();
    }
}
