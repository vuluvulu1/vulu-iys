@* Yan menünün altındaki oturum bölümü: kim giriş yapmış, şifre değiştirme ve çıkış. *@
@inject OturumServisi Oturum

<div class="oturum">
    <div class="oturum-adi">@Oturum.Kullanici?.AdSoyad</div>
    <div class="oturum-rol">@Rol</div>
    <button class="ikincil" @onclick="() => _sifrePenceresi = true">Şifre değiştir</button>
    <button class="ikincil" @onclick="Oturum.CikisYap">Çıkış yap</button>
</div>

@if (_sifrePenceresi)
{
    <SifreDegistirme Kapat="() => _sifrePenceresi = false" />
}

@code {
    [Parameter, EditorRequired] public string Rol { get; set; } = "";

    private bool _sifrePenceresi;
}
