@* Hizmeti kullanan işletmelerin listesi ve yeni işletme kaydı. *@
@inject ApiIstemcisi Api

<h1>İşletmeler</h1>

<div class="arac-cubugu">
    <button @onclick="YeniAc">İşletme kaydı</button>
    <button class="ikincil" @onclick="Yukle" disabled="@_yukleniyor">Yenile</button>
</div>

@if (_listeHatasi is not null)
{
    <p class="hata" role="alert">@_listeHatasi</p>
}

@if (_isletmeler is null)
{
    <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
}
else if (_isletmeler.Count == 0)
{
    <p class="soluk">Kayıtlı işletme bulunmuyor. “İşletme kaydı” düğmesiyle ilk işletmeyi açabilirsiniz.</p>
}
else
{
    <table class="tablo">
        <thead>
            <tr>
                <th>İşletme</th>
                <th>Kod</th>
                <th>Personel</th>
                <th>Açılış</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var isletme in _isletmeler)
            {
                <tr @key="isletme.Id">
                    <td>
                        <span class="logolu-ad">
                            @if (_logolar.TryGetValue(isletme.Id, out var logo))
                            {
                                <img src="@logo" alt="" />
                            }
                            else
                            {
                                @* Logosu olmayan (ya da logosu henüz yüklenmemiş) işletme, adının baş harfiyle gösterilir. *@
                                <span class="logo-yer-tutucu" aria-hidden="true">@BasHarf(isletme.Ad)</span>
                            }
                            @isletme.Ad
                        </span>
                    </td>
                    <td><code>@isletme.Kod</code></td>
                    <td class="dar">@isletme.PersonelSayisi</td>
                    <td class="dar">@Bicim.Tarih(isletme.OlusturmaTarihi)</td>
                    <td>
                        <span class="@(isletme.AktifMi ? "durum iyi" : "durum kotu")">
                            @(isletme.AktifMi ? "Açık" : "Askıda")
                        </span>
                    </td>
                    <td class="islemler">
                        <button class="ikincil" @onclick="() => _yonetilen = isletme">Yönet</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="sayfalama">
        <span class="soluk">@_isletmeler.Count işletme</span>
    </div>
}

@if (_yeni is not null)
{
    <Pencere Baslik="İşletme kaydı" Genis="true" KapatIstendi="YeniyiKapat">
        <form @onsubmit="Olustur">
            <div class="iki-sutun">
                <div>
                    <label for="i-ad">İşletme adı</label>
                    <input id="i-ad" @bind="_yeni.Ad" @bind:event="oninput" autocomplete="off" />
                </div>
                <div>
                    <label for="i-kod">İşletme kodu</label>
                    <input id="i-kod" @bind="_yeni.Kod" @bind:event="oninput" autocomplete="off" autocapitalize="none"
                           spellcheck="false" placeholder="ornek-servis" />
                </div>
            </div>
            <p class="soluk aciklama">
                Personel giriş ekranında bu kodu yazar. Küçük harf, rakam ve tire; açıldıktan sonra değiştirilemez.
            </p>

            <label for="i-adres">Adres</label>
            <textarea id="i-adres" rows="2" @bind="_yeni.Adres" @bind:event="oninput"></textarea>

            <div class="iki-sutun">
                <div>
                    <label for="i-telefon">Telefon</label>
                    <input id="i-telefon" @bind="_yeni.Telefon" @bind:event="oninput" inputmode="numeric" maxlength="11"
                           placeholder="03801234567" autocomplete="off" />
                </div>
                <div>
                    <label for="i-eposta">E-posta</label>
                    <input id="i-eposta" type="email" @bind="_yeni.Eposta" @bind:event="oninput" autocomplete="off" />
                </div>
            </div>

            <h3 class="form-basligi">İşletmenin ilk yöneticisi</h3>

            <label for="i-yonetici-ad">Ad soyad</label>
            <input id="i-yonetici-ad" @bind="_yeni.YoneticiAdSoyad" @bind:event="oninput" autocomplete="off" />

            <div class="iki-sutun">
                <div>
                    <label for="i-yonetici-kullanici">Kullanıcı adı</label>
                    <input id="i-yonetici-kullanici" @bind="_yeni.YoneticiKullaniciAdi" @bind:event="oninput" autocomplete="off" />
                </div>
                <div>
                    <label for="i-yonetici-sifre">Şifre</label>
                    <input id="i-yonetici-sifre" type="password" @bind="_yeni.YoneticiSifre" @bind:event="oninput" autocomplete="new-password" />
                </div>
            </div>
            <p class="soluk aciklama">
                Bu bilgileri işletmeye siz iletirsiniz. Yönetici giriş yaptıktan sonra kendi personelini ekler.
            </p>

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="YeniyiKapat" />
        </form>
    </Pencere>
}

@if (_yonetilen is not null)
{
    <IsletmeYonetimi Isletme="_yonetilen" Degisti="YonetilenDegisti" Silindi="YonetilenSilindi" Kapat="() => _yonetilen = null" />
}

@code {
    private class YeniIsletme
    {
        public string Ad { get; set; } = "";
        public string Kod { get; set; } = "";
        public string Adres { get; set; } = "";
        public string Telefon { get; set; } = "";
        public string Eposta { get; set; } = "";
        public string YoneticiAdSoyad { get; set; } = "";
        public string YoneticiKullaniciAdi { get; set; } = "";
        public string YoneticiSifre { get; set; } = "";
    }

    private List<IsletmeYaniti>? _isletmeler;

    // İşletme kimliği -> logonun sayfaya gömülen adresi. Liste logo içeriğini taşımaz; her logo bir kez indirilir.
    private readonly Dictionary<string, string> _logolar = [];
    private string? _listeHatasi;
    private bool _yukleniyor;

    private YeniIsletme? _yeni;
    private string? _formHatasi;
    private bool _kaydediliyor;

    private IsletmeYaniti? _yonetilen;

    protected override Task OnInitializedAsync() => Yukle();

    private async Task Yukle()
    {
        _yukleniyor = true;
        var sonuc = await Api.Getir<List<IsletmeYaniti>>("api/platform/isletmeler");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (!sonuc.Basarili) return;

        _isletmeler = sonuc.Deger ?? [];

        // Liste hemen gösterilir; logolar arkasından, hepsi birlikte indirilir.
        StateHasChanged();
        await LogolariYukle(_isletmeler);
    }

    private async Task LogolariYukle(List<IsletmeYaniti> isletmeler)
    {
        // Logosu kaldırılmış ya da silinmiş işletmelerin eski görseli kalmasın.
        var logolular = isletmeler.Where(i => i.LogoTuru is not null).ToList();
        foreach (var kimlik in _logolar.Keys.Except(logolular.Select(i => i.Id)).ToList())
            _logolar.Remove(kimlik);

        var indirilenler = await Task.WhenAll(logolular.Select(async isletme =>
            (isletme, Sonuc: await Api.Indir($"api/platform/isletmeler/{isletme.Id}/logo"))));

        // Logo indirilemezse satır baş harfle kalır; liste bunun için hata göstermez.
        foreach (var (isletme, logo) in indirilenler)
            if (logo is { Basarili: true, Deger: not null })
                _logolar[isletme.Id] = $"data:{isletme.LogoTuru};base64,{Convert.ToBase64String(logo.Deger)}";
    }

    private static string BasHarf(string ad) =>
        ad.Trim() is { Length: > 0 } dolu ? dolu[..1].ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) : "?";

    private void YeniAc()
    {
        _formHatasi = null;
        _yeni = new YeniIsletme();
    }

    private void YeniyiKapat() => _yeni = null;

    private async Task Olustur()
    {
        if (_yeni is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = await Api.Ekle<IsletmeYaniti>("api/platform/isletmeler",
            new IsletmeOlusturIstegi(_yeni.Kod.Trim().ToLowerInvariant(), _yeni.Ad.Trim(),
                _yeni.Adres.Trim(), _yeni.Telefon.Trim(), _yeni.Eposta.Trim(),
                _yeni.YoneticiKullaniciAdi.Trim(), _yeni.YoneticiSifre, _yeni.YoneticiAdSoyad.Trim()));
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _yeni = null;
        await Yukle();
    }

    // Yönetim penceresi açık kalır ve güncel kaydı gösterir; liste de arkada yenilenir.
    private Task YonetilenDegisti(IsletmeYaniti isletme)
    {
        _yonetilen = isletme;
        return Yukle();
    }

    private Task YonetilenSilindi()
    {
        _yonetilen = null;
        return Yukle();
    }
}
