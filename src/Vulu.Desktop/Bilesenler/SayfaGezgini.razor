@* Sayfalanmış listelerin altındaki toplam sayısı ve Önceki / Sonraki düğmeleri. *@
@typeparam TOge

<div class="sayfalama">
    <span class="soluk">@Sayfa.Toplam @Birim</span>
    @if (Sayfa.SayfaSayisi > 1)
    {
        <button class="ikincil" @onclick="() => SayfaIstendi.InvokeAsync(Sayfa.SayfaNo - 1)" disabled="@(Sayfa.SayfaNo <= 1)">Önceki</button>
        <span>@Sayfa.SayfaNo / @Sayfa.SayfaSayisi</span>
        <button class="ikincil" @onclick="() => SayfaIstendi.InvokeAsync(Sayfa.SayfaNo + 1)"
                disabled="@(Sayfa.SayfaNo >= Sayfa.SayfaSayisi)">Sonraki</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public Sayfa<TOge> Sayfa { get; set; } = null!;

    // Sayının yanına yazılan ad: "kayıt", "parça".
    [Parameter] public string Birim { get; set; } = "kayıt";

    [Parameter] public EventCallback<int> SayfaIstendi { get; set; }
}
