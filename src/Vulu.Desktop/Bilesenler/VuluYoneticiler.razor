@* İşletme kaydı açabilen vulu yöneticisi hesapları. *@
@inject ApiIstemcisi Api
@inject OturumServisi Oturum

<h1>Vulu Yöneticileri</h1>

<div class="arac-cubugu">
    <button @onclick="YeniAc">Yeni yönetici</button>
    <button class="ikincil" @onclick="Yukle" disabled="@_yukleniyor">Yenile</button>
</div>

@if (_listeHatasi is not null)
{
    <p class="hata" role="alert">@_listeHatasi</p>
}

@if (_yoneticiler is null)
{
    <p class="soluk">@(_yukleniyor ? "Yükleniyor…" : "")</p>
}
else
{
    <table class="tablo">
        <thead>
            <tr>
                <th>Ad soyad</th>
                <th>Kullanıcı adı</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var yonetici in _yoneticiler)
            {
                <tr @key="yonetici.Id">
                    <td>
                        @yonetici.AdSoyad
                        @if (yonetici.Id == Oturum.Kullanici?.Id)
                        {
                            <span class="rozet">siz</span>
                        }
                    </td>
                    <td>@yonetici.KullaniciAdi</td>
                    <td>
                        <span class="@(yonetici.AktifMi ? "durum iyi" : "durum kotu")">
                            @(yonetici.AktifMi ? "Aktif" : "Devre dışı")
                        </span>
                    </td>
                    <td class="islemler">
                        <button class="ikincil" @onclick="() => DuzenleAc(yonetici)">Düzenle</button>
                        <button class="tehlike" @onclick="() => _silinecek = yonetici"
                                disabled="@(yonetici.Id == Oturum.Kullanici?.Id)">Sil</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="soluk aciklama">
        Vulu yöneticileri işletme açabilir, askıya alabilir, silebilir ve birbirlerinin hesabını yönetebilir.
        Giriş ekranında işletme kodu olarak <code>@IsletmeKurallari.PlatformKodu</code> yazarlar.
    </p>
}

@if (_form is not null)
{
    <Pencere Baslik="@(_duzenlenen is null ? "Yeni vulu yöneticisi" : "Vulu yöneticisini düzenle")" KapatIstendi="FormuKapat">
        <form @onsubmit="Kaydet">
            <label for="v-adsoyad">Ad soyad</label>
            <input id="v-adsoyad" @bind="_form.AdSoyad" @bind:event="oninput" autocomplete="off" />

            <label for="v-ad">Kullanıcı adı</label>
            <input id="v-ad" @bind="_form.KullaniciAdi" @bind:event="oninput" autocomplete="off" disabled="@(_duzenlenen is not null)" />

            <label for="v-sifre">@(_duzenlenen is null ? "Şifre" : "Yeni şifre (boşsa değişmez)")</label>
            <input id="v-sifre" type="password" @bind="_form.Sifre" @bind:event="oninput" autocomplete="new-password" />

            @if (_duzenlenen is not null)
            {
                <label class="onay-kutusu">
                    <input id="v-aktif" type="checkbox" @bind="_form.AktifMi" />
                    Hesap aktif
                </label>
            }

            <FormAltligi Hata="@_formHatasi" Mesgul="_kaydediliyor" Vazgec="FormuKapat" />
        </form>
    </Pencere>
}

@if (_silinecek is not null)
{
    <SilmeOnayi Baslik="Vulu yöneticisini sil" Hata="@_silmeHatasi" Mesgul="_kaydediliyor" Onayla="Sil" Vazgec="SilmeyiKapat">
        <strong>@_silinecek.AdSoyad</strong> (@_silinecek.KullaniciAdi) artık işletmeleri yönetemeyecek. Bu işlem geri alınamaz.
    </SilmeOnayi>
}

@code {
    private class YoneticiFormu
    {
        public string AdSoyad { get; set; } = "";
        public string KullaniciAdi { get; set; } = "";
        public string Sifre { get; set; } = "";
        public bool AktifMi { get; set; } = true;
    }

    private List<VuluYoneticisiYaniti>? _yoneticiler;
    private string? _listeHatasi;
    private bool _yukleniyor;

    private YoneticiFormu? _form;
    private VuluYoneticisiYaniti? _duzenlenen;
    private string? _formHatasi;
    private bool _kaydediliyor;

    private VuluYoneticisiYaniti? _silinecek;
    private string? _silmeHatasi;

    protected override Task OnInitializedAsync() => Yukle();

    private async Task Yukle()
    {
        _yukleniyor = true;
        var sonuc = await Api.Getir<List<VuluYoneticisiYaniti>>("api/platform/yoneticiler");
        _yukleniyor = false;

        _listeHatasi = sonuc.Hata;
        if (sonuc.Basarili)
            _yoneticiler = sonuc.Deger ?? [];
    }

    private void YeniAc()
    {
        _duzenlenen = null;
        _formHatasi = null;
        _form = new YoneticiFormu();
    }

    private void DuzenleAc(VuluYoneticisiYaniti yonetici)
    {
        _duzenlenen = yonetici;
        _formHatasi = null;
        _form = new YoneticiFormu { AdSoyad = yonetici.AdSoyad, KullaniciAdi = yonetici.KullaniciAdi, AktifMi = yonetici.AktifMi };
    }

    private void FormuKapat() => _form = null;

    private async Task Kaydet()
    {
        if (_form is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = _duzenlenen is null
            ? await Api.Ekle<VuluYoneticisiYaniti>("api/platform/yoneticiler",
                new VuluYoneticisiOlusturIstegi(_form.KullaniciAdi.Trim(), _form.Sifre, _form.AdSoyad.Trim()))
            : await Api.Guncelle<VuluYoneticisiYaniti>($"api/platform/yoneticiler/{_duzenlenen.Id}",
                new VuluYoneticisiGuncelleIstegi(_form.AdSoyad.Trim(), _form.AktifMi, _form.Sifre.Length > 0 ? _form.Sifre : null));
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _formHatasi = sonuc.Hata;
            return;
        }

        _form = null;
        await Yukle();
    }

    private void SilmeyiKapat()
    {
        _silinecek = null;
        _silmeHatasi = null;
    }

    private async Task Sil()
    {
        if (_silinecek is null || _kaydediliyor) return;

        _kaydediliyor = true;
        var sonuc = await Api.Sil($"api/platform/yoneticiler/{_silinecek.Id}");
        _kaydediliyor = false;

        if (!sonuc.Basarili)
        {
            _silmeHatasi = sonuc.Hata;
            return;
        }

        SilmeyiKapat();
        await Yukle();
    }
}
